# Environment Variables for AKGEC Online Examination Backend

# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/quiz-portal

# JWT Secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_FROM=noreply@quizportal.com

# Redis Config (Queue, Cache, Socket)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=rediss://default:your_password@your_upstash_host:6379 (Optional, use instead of HOST/PORT for cloud Redis)

# Security
FRONTEND_URL=http://localhost:3000
# Set RECAPTCHA_ENABLED=true to activate Google reCAPTCHA v3 verification on login (score threshold: 0.5)
# Leave unset or false to bypass (e.g. during development / before reCAPTCHA keys are provisioned)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
